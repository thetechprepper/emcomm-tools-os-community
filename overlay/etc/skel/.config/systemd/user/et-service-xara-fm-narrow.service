# Date    : 27 October 2026
# Purpose : User systemd unit file for EmComm Tools xara FM service
#
# Usage: 
#  Check status       : systemctl --user status et-service-xara-fm-narrow
#  Start service      : systemctl --user start et-service-xara-fm-narrow
#  Stop service       : systemctl --user stop et-service-xara-fm-narrow
#  Reload this config : systemctl --user daemon-reload

[Unit]
Description=EmComm Tools xara FM service (narrow bandwidth)

[Service]
ExecStart=/opt/emcomm-tools/bin/et-xara start-xara-fm-narrow
Restart=no

[Install]
WantedBy=multi-user.target
