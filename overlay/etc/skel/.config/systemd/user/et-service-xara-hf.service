# Date    : 26 October 2026
# Purpose : User systemd unit file for EmComm Tools xara HF service
#
# Usage: 
#  Check status       : systemctl --user status et-service-xara
#  Start service      : systemctl --user start et-service-xara
#  Stop service       : systemctl --user stop et-service-xara
#  Reload this config : systemctl --user daemon-reload

[Unit]
Description=EmComm Tools xara HF service
# Disable conditional check for audio device. Allow et-xara to enforce.
#ConditionPathExists=/dev/et-audio

[Service]
ExecStart=/opt/emcomm-tools/bin/et-xara
Restart=no

[Install]
WantedBy=multi-user.target
