# Purpose : User systemd unit file for EmComm Tools xara HF service
#
# Usage: 
#  Check status       : systemctl --user status et-service-xara-hf-2300
#  Start service      : systemctl --user start et-service-xara-hf-2300
#  Stop service       : systemctl --user stop et-service-xara-hf-2300
#  Reload this config : systemctl --user daemon-reload

[Unit]
Description=EmComm Tools xara HF service (2300 bandwidth)

[Service]
ExecStart=/opt/emcomm-tools/bin/et-xara start-xara-hf-2300
Restart=no

[Install]
WantedBy=multi-user.target
