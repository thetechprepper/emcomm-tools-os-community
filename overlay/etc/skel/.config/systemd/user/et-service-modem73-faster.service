# Author  : Gaston Gonzalez
# Date    : 30 June 2026
# Purpose : User systemd unit file for EmComm Tools that starts modem73
#         : in a faster configuration.
#
# Usage: 
#  Check status       : systemctl --user status et-service-modem73-faster
#  Start service      : systemctl --user start et-service-modem73-faster
#  Stop service       : systemctl --user stop et-service-modem73-faster
#  Reload this config : systemctl --user daemon-reload

[Unit]
Description=EmComm Tools modem73 service for faster performance

[Service]
ExecStart=/opt/emcomm-tools/bin/et-modem73 faster --headless
Restart=no

[Install]
WantedBy=multi-user.target
