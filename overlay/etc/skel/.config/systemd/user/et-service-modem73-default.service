# Date    : 28 June 2026
# Purpose : User systemd unit file for EmComm Tools that starts modem73
#         : in a default configuration.
#
# Usage: 
#  Check status       : systemctl --user status et-service-modem73-default
#  Start service      : systemctl --user start et-service-modem73-default
#  Stop service       : systemctl --user stop et-service-modem73-default
#  Reload this config : systemctl --user daemon-reload

[Unit]
Description=EmComm Tools modem73 default service

[Service]
ExecStart=/opt/emcomm-tools/bin/et-modem73 start default
Restart=no

[Install]
WantedBy=multi-user.target
