#!/bin/bash
#
# Author  : Gaston Gonzalez
# Date    : 26 October 2026
# Purpose : Wrapper script for starting xara modem
#
# Preconditions:
# 1. Supported radio and audio interface are connected and properly detected
#
# Postconditions:
# 1. Audio settings updated
# 2. xara modem started

# TODO
# - Make more robust
# - Check for supported devices or bail
# - Update regression

[[ -z "${ET_USER_CONFIG}" ]] && ET_USER_CONFIG="${HOME}/.config/emcomm-tools/user.json"

CALLSIGN=$(cat ${ET_USER_CONFIG} | jq -r .callsign)

CARD=$(et-system-info et-audio-card | cut -d"," -f 1)
DEVICE=$(et-system-info et-audio-card | cut -d"," -f 2)

xara --call ${CALLSIGN} \
  --hf 2300 \
  --audio alsa \
  --capture plughw:CARD=${CARD},DEV=${DEVICE} \
  --playback plughw:CARD=${CARD},DEV=${DEVICE} \
  --radio \
  --ptt rigctld:127.0.01:4532
